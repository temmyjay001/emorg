{
  "name": "emorg",
  "version": "0.1.0-beta.1",
  "private": false,
  "type": "module",
  "description": "A local engineering org run by isolated AI agents: tickets, design, code, review, UAT loops, and gated state transitions.",
  "bin": {
    "em": "dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "em": "tsx src/index.ts",
    "web": "npm run ui:build && tsx src/web/main.ts",
    "web:api": "tsx src/web/main.ts",
    "ui:build": "vite build",
    "ui:dev": "vite",
    "build": "npm run ui:build && tsup && rm -rf dist/prompts dist/assets && cp -R src/agents/prompts dist/prompts && cp -R src/web/assets dist/assets",
    "start": "node dist/web.js",
    "typecheck": "tsc --noEmit && tsc -p src/web/ui/tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.222",
    "better-sqlite3": "^11.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.23.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/temmyjay001/emorg.git"
  },
  "homepage": "https://emorg.uncu.me",
  "bugs": {
    "url": "https://github.com/temmyjay001/emorg/issues"
  },
  "keywords": [
    "ai-agents",
    "engineering-org",
    "multi-agent",
    "code-review",
    "tickets",
    "claude",
    "gemini",
    "agent-orchestration",
    "cli"
  ],
  "license": "MIT"
}
